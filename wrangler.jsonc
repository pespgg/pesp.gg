{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pespgg",
  "compatibility_date": "2025-12-20",
  "main": ".output/server/index.mjs",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "pesp.gg",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pesp",
      "database_id": "2eed6779-b388-4d6f-8794-9de76c5d202e",
      "migrations_dir": ".output/server/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOB",
      "bucket_name": "pesp"
    }
  ]
}
